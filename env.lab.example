# Réseau fictif pour scripts/lab-failover.sh. Aucun trafic LAN réel.
COMPOSE_PROFILES=bundle

TZ=Europe/Paris

LAN_PARENT=pihole-dummy
LAN_SUBNET=192.168.199.0/24
LAN_GATEWAY=192.168.199.1

VIP=192.168.199.10
VIP_CIDR=192.168.199.10/24

VRRP_ROUTER_ID=51
VRRP_AUTH_PASS=PiH0leHA
PIHOLE_PASSWORD=lab-only-password

UPSTREAM_1=1.1.1.1
UPSTREAM_2=9.9.9.9
DNSSEC=false

SYNC_CRON="*/15 * * * *"
RUN_GRAVITY=false
CLUSTER_INTERFACE=auto
NODE1_PRIORITY=150
NODE2_PRIORITY=100
KEEPALIVED_DEBUG=0

PEER_HOST_1=pihole-2
PEER_HOST_2=pihole-1
REPLICA_HOST=pihole-2

TRAEFIK_ENABLE=false
TRAEFIK_EXTERNAL=false
TRAEFIK_DOCKER_NETWORK=pihole-lab-proxy
TRAEFIK_HOST=pihole.lab
TRAEFIK_ENTRYPOINT=web
TRAEFIK_TLS=false
TRAEFIK_CERTRESOLVER=
TRAEFIK_SERVICE_PORT=80
TRAEFIK_REPLICA_ENABLE=false
TRAEFIK_HOST_REPLICA=pihole-replica.lab
