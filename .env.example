# Copier vers .env puis adapter. Ne pas committer .env.
# Démarrage des deux nœuds sur cette machine : bundle
# Machine 1 d'une paire physique : node1
# Machine 2 d'une paire physique : node2
COMPOSE_PROFILES=bundle

TZ=Europe/Paris

# Carte physique du LAN (ip -br link). Promiscuous mode requis par macvlan.
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Trois adresses libres, dans LAN_SUBNET, hors DHCP.
NODE1_IP=192.168.1.11
NODE2_IP=192.168.1.12
VIP=192.168.1.10
VIP_CIDR=192.168.1.10/24

# 1–255, unique sur le VLAN (ne pas réutiliser un autre cluster VRRP).
VRRP_ROUTER_ID=51
# 8 caractères maximum (limite keepalived PASS).
VRRP_AUTH_PASS=PiH0leHA

# Mot de passe de l'interface et de l'API. Sans | , $ ni espace.
PIHOLE_PASSWORD=changeme-now

# Résolveurs amont des deux Pi-hole, et DNS des conteneurs pour gravity.
UPSTREAM_1=1.1.1.1
UPSTREAM_2=9.9.9.9
DNSSEC=false

# nebula-sync. Éviter chaque minute : l'API Pi-hole s'en lasse.
SYNC_CRON="*/15 * * * *"
# true : gravity est recalculé sur le réplica après chaque synchro.
RUN_GRAVITY=true

# auto : l'interface qui porte NODE*_IP. Forcer eth0 seulement si la détection échoue.
CLUSTER_INTERFACE=auto

# Priorités VRRP. L'écart doit rester inférieur au poids du healthcheck (−60)
# pour que le primaire lâche la VIP quand son DNS ne répond plus.
NODE1_PRIORITY=150
NODE2_PRIORITY=100

KEEPALIVED_DEBUG=0

# ---------------------------------------------------------------------------
# Traefik (UI admin uniquement — le DNS reste sur la VIP / macvlan)
# ---------------------------------------------------------------------------
# true  : attache pihole-1 au réseau Docker de Traefik et publie les labels.
# false : pas de proxy ; admin uniquement sur http://NODE1_IP/admin
TRAEFIK_ENABLE=true
# true  : TRAEFIK_DOCKER_NETWORK existe déjà (réseau de ton stack Traefik).
# false : Compose crée un bridge local (lab / sans Traefik).
TRAEFIK_EXTERNAL=true
# Nom du réseau Docker où tourne Traefik (docker network ls).
TRAEFIK_DOCKER_NETWORK=traefik
# Hostname public de l'admin du primaire (là où tu modifies les listes).
TRAEFIK_HOST=pihole.example.com
# Entrypoint Traefik (souvent websecure pour HTTPS, web pour HTTP).
TRAEFIK_ENTRYPOINT=websecure
# true derrière HTTPS terminé par Traefik.
TRAEFIK_TLS=true
# Nom du certresolver ACME dans ta config Traefik (vide si certificats fichiers).
TRAEFIK_CERTRESOLVER=letsencrypt
# Port HTTP interne de Pi-hole que Traefik joint (défaut 80).
TRAEFIK_SERVICE_PORT=80
# Exposer aussi l'admin du réplica (lecture) derrière Traefik.
TRAEFIK_REPLICA_ENABLE=false
# Hostname du réplica si TRAEFIK_REPLICA_ENABLE=true.
TRAEFIK_HOST_REPLICA=pihole-replica.example.com
