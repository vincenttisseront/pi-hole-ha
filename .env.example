# Copier vers .env puis adapter. Ne pas committer .env.
# bundle = 2 Pi-hole + dnsdist sur cet hôte
COMPOSE_PROFILES=bundle

TZ=Europe/Paris

# Mot de passe UI / API. Sans | , $ ni espace.
PIHOLE_PASSWORD=changeme-now

# Résolveurs amont (gravity + Pi-hole).
UPSTREAM_1=1.1.1.1
UPSTREAM_2=9.9.9.9
DNSSEC=false

# nebula-sync
SYNC_CRON="*/15 * * * *"
RUN_GRAVITY=true
# Nom Docker du réplica (pas une IP).
REPLICA_HOST=pihole-2

# ---------------------------------------------------------------------------
# Réseau Docker (IP des conteneurs = Docker, rien à saisir)
# ---------------------------------------------------------------------------
# Ex. vpcbr — le même réseau que Traefik (docker network ls).
DOCKER_NETWORK=vpcbr
# true = le réseau existe déjà ; false = Compose crée un bridge (lab).
DOCKER_NETWORK_EXTERNAL=true

# DNS des clients = cet hôte.
# Préfère l'IP LAN de la VM (évite le conflit avec systemd-resolved sur 127.0.0.53
# ou un autre service déjà en 0.0.0.0:53) :
#   DNS_HOST_IP=172.24.0.110
# 0.0.0.0 = toutes les interfaces (échoue si :53 est déjà pris).
DNS_HOST_IP=0.0.0.0

# ---------------------------------------------------------------------------
# Traefik (UI admin du primaire uniquement)
# ---------------------------------------------------------------------------
TRAEFIK_ENABLE=true
TRAEFIK_HOST=pihole.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_SERVICE_PORT=80
TRAEFIK_REPLICA_ENABLE=false
TRAEFIK_HOST_REPLICA=pihole-replica.example.com
