global_defs {
    router_id ${ROUTER_ID}
    script_user root
    enable_script_security
    vrrp_skip_check_adv_addr
}

vrrp_script chk_pihole {
    script "/usr/local/bin/check-dns.sh"
    interval 2
    timeout 3
    fall 2
    rise 2
    weight -60
}

vrrp_instance PIHOLE_VIP {
    # Les deux nœuds démarrent BACKUP. La priorité élit le maître.
    # nopreempt évite qu'un nœud revenu de panne reprenne la VIP tout de suite.
    state BACKUP
    interface ${INTERFACE}
    virtual_router_id ${VRRP_ROUTER_ID}
    priority ${PRIORITY}
    advert_int 1
    nopreempt

    unicast_src_ip ${SRC_IP}
    unicast_peer {
        ${PEER_IP}
    }

    authentication {
        auth_type PASS
        auth_pass ${VRRP_AUTH_PASS}
    }

    virtual_ipaddress {
        ${VIP_CIDR}
    }

    track_script {
        chk_pihole
    }

    garp_master_refresh 5
    garp_master_refresh_repeat 2
}
